# TerminalViewer: 터미널 셰이더 원본(GLSL)의 SHA256 이 shaders.sha256 에 적힌 값과 같은지 확인한다.
#   저장소에는 원본, 만든 SPIR-V(.spv), 원본 해시 목록(shaders.sha256)을 함께 둔다. 일반 빌드는 저장소의 SPIR-V 를 그대로 쓰므로
#   glslc(Vulkan SDK)가 필요 없다. 원본만 고치고 SPIR-V 를 다시 만들지 않으면 이 검사가 구성을 멈춘다.
#   구성할 때: include(cmake/CheckShaders.cmake) 뒤 terminalviewer_check_shaders(<셰이더 폴더>)
#   단독 실행: cmake -DSHADER_DIR=<셰이더 폴더> -P cmake/CheckShaders.cmake   (CTest TerminalViewerShaderHashTest 가 쓴다)
#   다시 만들기: cmake -DGLSLC=<glslc 경로> -P tools/shaders/BuildShaders.cmake

set(TERMINALVIEWER_SHADER_SOURCES terminal.vert terminal.frag)
set(TERMINALVIEWER_SHADER_HASH_FILE shaders.sha256)

function(terminalviewer_check_shaders shaderDir)
    set(problems "")
    set(listFile "${shaderDir}/${TERMINALVIEWER_SHADER_HASH_FILE}")
    set(lines "")
    if(EXISTS "${listFile}")
        file(STRINGS "${listFile}" lines)
    else()
        string(APPEND problems "\n  ${TERMINALVIEWER_SHADER_HASH_FILE} 가 없다")
    endif()
    foreach(name IN LISTS TERMINALVIEWER_SHADER_SOURCES)
        set(sourceFile "${shaderDir}/${name}")
        if(NOT EXISTS "${sourceFile}")
            string(APPEND problems "\n  ${name} 가 없다")
            continue()
        endif()
        if(NOT EXISTS "${sourceFile}.spv")
            string(APPEND problems "\n  ${name}.spv 가 없다")
        endif()
        file(SHA256 "${sourceFile}" actual)
        set(expected "")
        foreach(line IN LISTS lines)
            string(REGEX REPLACE "\r$" "" line "${line}")
            if(line MATCHES "^([0-9a-f]+)  (.+)$" AND CMAKE_MATCH_2 STREQUAL name)
                set(expected "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        if(expected STREQUAL "")
            string(APPEND problems "\n  ${name}: ${TERMINALVIEWER_SHADER_HASH_FILE} 에 해시가 없다")
        elseif(NOT expected STREQUAL actual)
            string(APPEND problems "\n  ${name}: 기록 ${expected}, 지금 ${actual}")
        endif()
    endforeach()
    if(NOT problems STREQUAL "")
        message(FATAL_ERROR "셰이더 원본이 바뀌었다. glslc 로 tools/shaders/BuildShaders.cmake 를 돌려라 "
                            "(cmake -DGLSLC=<glslc 경로> -P tools/shaders/BuildShaders.cmake). 폴더: ${shaderDir}${problems}")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT SHADER_DIR)
        message(FATAL_ERROR "사용: cmake -DSHADER_DIR=<셰이더 폴더> -P ${CMAKE_CURRENT_LIST_FILE}")
    endif()
    terminalviewer_check_shaders("${SHADER_DIR}")
    message(STATUS "TerminalViewer: shader sources match ${TERMINALVIEWER_SHADER_HASH_FILE} (${SHADER_DIR})")
endif()
